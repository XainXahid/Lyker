# Copy this file to .env and fill it in. Never commit .env.

# Shown to buyers ("Zain will reach out…") and in the consent text.
AGENT_NAME=Zain
BROKERAGE=

# Passcode for the agent dashboard at /agent
AGENT_PASSCODE=change-me

# Follow Up Boss → Admin → API → Create API Key. Leave blank to keep leads local only.
FUB_API_KEY=
# Optional: from registering Lyker as a system at https://apps.followupboss.com/system-registration
FUB_SYSTEM=Lyker
FUB_SYSTEM_KEY=

# Where Lyker is reachable — used for the listing links inside Follow Up Boss.
PUBLIC_URL=http://localhost:4780
PORT=4780
